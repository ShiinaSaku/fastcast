{
  "compilerOptions": {
    "target": "ESNext",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "fastcast/helpers": [
        "./src/helpers/index.ts"
      ],
      "fastcast": [
        "./src/index.ts"
      ],
      "magicast/helpers": [
        "./src/helpers/index.ts"
      ],
      "magicast": [
        "./src/index.ts"
      ]
    },
    "strict": true,
    "esModuleInterop": true
  },
  "exclude": [
    "dist",
    "vendor",
    "eslint.config.ts"
  ]
}
